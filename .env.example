# Configuración de Ejemplo para NitroCore API en Fly.io (GRATIS)
# Copia este archivo a .env y actualiza los valores según sea necesario
# NOTA: Base de datos externa para mantener costos en $0

# Application
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=https://tu-dominio.com
APP_KEY=tu-clave-secreta-muy-segura-cambiar-en-produccion

# Database Provider
APP_DB_PROVIDER=postgres

# PostgreSQL Configuration (EXTERNA - Usar servicio gratuito)
# Opciones gratuitas:
# - Railway.app (PostgreSQL gratis)
# - Render.com (PostgreSQL gratis)
# - Supabase (PostgreSQL gratis)
# - Neon (PostgreSQL gratis)
# - Vercel Postgres (gratis con límites)

PG_DB_HOST=tu-host-externo.railway.app
PG_DB_PORT=5432
PG_DB_USER=postgres
PG_DB_PASSWORD=tu-contraseña-segura
PG_DB_NAME=redfox_db

# Database Options
DB_SYNC=false
DB_LOGGING=false

# FacturaAPI (opcional)
FACTURAPI_API_KEY=sk_test_tu_api_key_aqui

# Uploads / Storage
# Driver: 'local' (default) o 's3' (Railway Bucket, AWS S3, Cloudflare R2, etc.)
STORAGE_DRIVER=local

# Solo necesario si STORAGE_DRIVER=local
UPLOAD_DEST=./uploads
APP_PUBLIC_URL=https://tu-api.railway.app

# Solo necesario si STORAGE_DRIVER=s3
# Railway Bucket: copia estos valores desde la pestaña "Credentials" del bucket
S3_ENDPOINT=https://t3.storage.dev
S3_REGION=auto
S3_BUCKET_NAME=nombre-de-tu-bucket
S3_ACCESS_KEY_ID=tid_xxxxxxxxxxxx
S3_SECRET_ACCESS_KEY=tsec_xxxxxxxxxxxx
# URL pública del bucket (Railway: https://<bucket-name>.t3.storage.dev)
S3_PUBLIC_URL=https://nombre-de-tu-bucket.t3.storage.dev

# Email Configuration
EMAIL_FROM=noreply@nitro.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-contraseña-app-gmail

# Default Configuration
DEFAULT_ROLE_ID_FOR_USER_REGISTER=ADMIN
FRONTEND_URL=https://tu-dominio-frontend.com

# SAT Catalog (public endpoints — no auth required)
SAT_CATALOG_PRODUCTS_URL=https://factura123.mx/api/v2/public/cat/prodclasses
SAT_CATALOG_UNITS_URL=https://factura123.mx/api/v2/public/cat/units
